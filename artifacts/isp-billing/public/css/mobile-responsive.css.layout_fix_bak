/* ================================================================
   SMART ISP — MOBILE FIX v5.0  (Critical Corrections)
   Fixes: col-md-* revert, table overflow, word-break, layout
   ================================================================ */

/* ════════════════════════════════════════════════════════════
   SECTION 1: REVERT AGGRESSIVE col-md-* OVERRIDES
   v4.0 forced col-md-4 to 50% globally — wrong for sidebars,
   forms, detail pages. Restore to 100% (Bootstrap default).
   Only stat/widget rows get 50%.
   ════════════════════════════════════════════════════════════ */
@media (max-width: 767px) {
    /* Reset ALL col-md-* to 100% on mobile */
    .col-md-1, .col-md-2, .col-md-3, .col-md-4,
    .col-md-5, .col-md-6, .col-md-7, .col-md-8,
    .col-md-9, .col-md-10, .col-md-11, .col-md-12,
    .col-lg-1, .col-lg-2, .col-lg-3, .col-lg-4,
    .col-lg-5, .col-lg-6, .col-lg-7, .col-lg-8,
    .col-lg-9, .col-lg-10, .col-lg-11, .col-lg-12,
    .col-xl-1, .col-xl-2, .col-xl-3, .col-xl-4,
    .col-xl-5, .col-xl-6, .col-xl-7, .col-xl-8 {
        flex: 0 0 100% !important;
        max-width: 100% !important;
    }

    /* EXCEPTION: col-6 variants stay 50% (dashboard stat boxes) */
    .col-6 {
        flex: 0 0 50% !important;
        max-width: 50% !important;
    }
    .col-sm-6 {
        flex: 0 0 50% !important;
        max-width: 50% !important;
    }

    /* EXCEPTION: containers that directly hold info-box/small-box = 50% */
    [class*="col-"]:has(> .info-box) {
        flex: 0 0 50% !important;
        max-width: 50% !important;
        padding: 4px !important;
    }
    [class*="col-"]:has(> .small-box) {
        flex: 0 0 50% !important;
        max-width: 50% !important;
        padding: 4px !important;
    }
    [class*="col-"]:has(> .stat-card) {
        flex: 0 0 50% !important;
        max-width: 50% !important;
        padding: 4px !important;
    }
}

/* ════════════════════════════════════════════════════════════
   SECTION 2: FIX WORD BREAKING — no more letter-by-letter
   ════════════════════════════════════════════════════════════ */
@media (max-width: 991px) {
    /* Global word break fix */
    * {
        word-break: normal !important;
        overflow-wrap: normal !important;
    }

    /* Allow break only for very long single strings (URLs, codes) */
    td, th, .badge, p, span {
        word-break: break-word !important;
        overflow-wrap: break-word !important;
    }

    /* Strong/bold labels: never break in middle */
    strong, b, label, th {
        word-break: normal !important;
        overflow-wrap: normal !important;
        white-space: nowrap !important;
    }

    /* Alert text: allow wrapping at word boundaries only */
    .alert {
        word-break: normal !important;
        overflow-wrap: break-word !important;
        white-space: normal !important;
    }
    .alert strong {
        white-space: normal !important;
        word-break: normal !important;
    }
}

/* ════════════════════════════════════════════════════════════
   SECTION 3: HORIZONTAL SCROLL FIX — stop page-level scroll
   ════════════════════════════════════════════════════════════ */
@media (max-width: 991px) {
    html, body {
        overflow-x: hidden !important;
        max-width: 100vw !important;
    }

    .wrapper {
        overflow-x: hidden !important;
    }

    .content-wrapper {
        overflow-x: hidden !important;
        max-width: 100% !important;
    }

    .content {
        overflow-x: hidden !important;
    }

    /* Remove fixed widths from rows */
    .row {
        margin-left: -6px !important;
        margin-right: -6px !important;
        max-width: 100% !important;
    }

    [class*="col-"] {
        padding-left: 6px !important;
        padding-right: 6px !important;
    }
}

/* ════════════════════════════════════════════════════════════
   SECTION 4: ALL TABLES — compact, scrollable, no page scroll
   ════════════════════════════════════════════════════════════ */
@media (max-width: 991px) {
    /* Wrap every table in a scroll container */
    .card-body .table-responsive,
    .card .table-responsive {
        overflow-x: auto !important;
        -webkit-overflow-scrolling: touch !important;
        max-width: 100% !important;
        border-radius: 4px !important;
