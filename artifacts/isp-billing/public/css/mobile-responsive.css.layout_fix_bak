/* ==================== BILL & PAYMENT CUBE BOX DESIGN ==================== */
.bill-grid,
.payment-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 12px;
    padding: 10px 0;
}

.bill-card,
.payment-card {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    overflow: hidden;
    transition: all 0.3s ease;
    border: 2px solid #e2e8f0;
}

.bill-card:hover,
.payment-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 4px 15px rgba(0,0,0,0.15);
}

.bill-card.paid {
    border-color: #38a169;
}

.bill-card.unpaid {
    border-color: #ed8936;
}

.bill-card-header,
.payment-card-header {
    background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%);
    padding: 10px 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #e2e8f0;
}

.bill-month,
.payment-date {
    font-weight: 700;
    font-size: 13px;
    color: #2d3748;
}

.bill-card-body,
.payment-card-body {
    padding: 12px;
    text-align: center;
}

.bill-amount,
.payment-amount {
    font-size: 22px;
    font-weight: 700;
    color: #2d3748;
    margin-bottom: 4px;
}

.payment-amount {
    color: #38a169;
}

.bill-due {
    font-size: 12px;
    color: #718096;
}

.payment-ref {
    font-size: 11px;
}

