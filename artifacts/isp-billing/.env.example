# =====================================================
# ISP BILLING SYSTEM - DEPLOYMENT CONFIGURATION
# =====================================================
# Copy this file to .env and configure for your server
# Works on: Localhost, VPS, Cloud, Shared Hosting
# =====================================================

# APPLICATION SETTINGS
APP_NAME="Smart Online ISP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# For production, increase workers (requires PHP 8.3+)
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# LOGGING
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
# Supports: PostgreSQL (recommended), MySQL, SQLite
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=isp_billing
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password

# =====================================================
# SESSION & CACHE
# =====================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=isp_

# =====================================================
# MAIL CONFIGURATION (For bill notifications)
# =====================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# =====================================================
# SMS GATEWAY (Bangladesh)
# =====================================================
# Configure in Admin Panel > Settings > SMS Settings
# Supports: BulkSMSBD, Infobip, Twilio, Custom API
SMS_ENABLED=true

# =====================================================
# PAYMENT GATEWAYS
# =====================================================
# Configure in Admin Panel > Settings > Payment Settings
# Supports: bKash, Nagad, Rocket, SSLCommerz

BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=false

NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_KEY=
NAGAD_SANDBOX=false

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=false

# =====================================================
# MIKROTIK ROUTER INTEGRATION
# =====================================================
# MikroTik routers are configured in Admin Panel:
# Go to: Settings > Network > MikroTik Devices
#
# Each router needs:
# - Name: Router identifier (e.g., "Main Router Zone-1")
# - Host: Router IP (e.g., 10.10.10.1 or public IP)
# - Port: API port (default 8728, SSL: 8729)
# - Username: API user with full access
# - Password: API password
# - Zone: Assign to specific zone
#
# IMPORTANT REQUIREMENTS:
# 1. Enable API on router: /ip service set api address=0.0.0.0/0 disabled=no
# 2. Create API user: /user add name=api group=full password=secure123
# 3. Allow firewall: /ip firewall filter add chain=input protocol=tcp dst-port=8728 action=accept
# 4. Package names MUST match MikroTik profile names exactly
#
# CONNECTION TYPES SUPPORTED:
# - PPPoE: /ppp/secret (most common for Bangladesh ISP)
# - Hotspot: /ip/hotspot/user (cafes, hotels)
# - Static IP: /ip/firewall/address-list + /queue/simple
# - DHCP: /ip/dhcp-server/lease + /queue/simple

# =====================================================
# FRONTEND BUILD
# =====================================================
VITE_APP_NAME="${APP_NAME}"

# =====================================================
# TRUSTED PROXIES (For load balancers/reverse proxy)
# =====================================================
TRUSTED_PROXIES=*

# =====================================================
# DEPLOYMENT CHECKLIST
# =====================================================
# 1. Set APP_ENV=production
# 2. Set APP_DEBUG=false
# 3. Generate APP_KEY: php artisan key:generate
# 4. Configure DATABASE credentials
# 5. Set APP_URL to your actual domain
# 6. Run: php artisan migrate --force
# 7. Run: php artisan config:cache
# 8. Run: php artisan route:cache
# 9. Run: php artisan view:cache
# 10. Set up SSL certificate (Let's Encrypt recommended)
# 11. Configure MikroTik devices in Admin Panel
# 12. Set up cron for scheduled tasks:
#     * * * * * cd /path-to-project && php artisan schedule:run >> /dev/null 2>&1
