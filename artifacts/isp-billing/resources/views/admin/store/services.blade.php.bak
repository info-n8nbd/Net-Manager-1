@push('scripts')
<script>
$(function() {
    $('#chargeTypeSelect').on('change', function() {
        $('#customChargeType').toggle($(this).val() === 'Other');
    });
    toggleSvcPaymentFields();

    $(document).on('click', '.edit-charge-btn', function() {
        var id = $(this).data('id');
        var chargeType = $(this).data('charge-type');
        var amount = $(this).data('amount');
        var description = $(this).data('description') || '';
        var paymentMethod = $(this).data('payment-method') || 'cash';
        var chargeDate = $(this).data('charge-date') || '';
        var transactionId = $(this).data('transaction-id') || '';
        var senderNumber = $(this).data('sender-number') || '';
        var moneyReceipt = $(this).data('money-receipt') || '';
        var isBase = $(this).data('is-base') == '1';

        $('#editChargeForm').attr('action', '{{ url("admin/sales/services") }}/' + id);
        $('#editAmount').val(amount);
        $('#editDescription').val(description);
        $('#editChargeDate').val(chargeDate);
        $('#editTransactionId').val(transactionId);
        $('#editSenderNumber').val(senderNumber);
        $('#editMoneyReceipt').val(moneyReceipt);

        if (isBase) {
            $('#editChargeTypeGroup, #editCustomChargeType, #editPaymentMethodGroup, #edit_online_fields, #edit_receipt_field, #editChargeDateGroup, #editDescriptionGroup').hide();
            $('#editAmountHint').show();
            $('#editAmount').attr('min', '0');
            $('#editChargeType').removeAttr('required');
            $('.edit-modal-title').html('<i class="fas fa-edit mr-2"></i>Edit Installation Charge Amount');
        } else {
            $('#editChargeTypeGroup, #editChargeDateGroup, #editDescriptionGroup').show();
            $('#editPaymentMethodGroup').show();
            $('#editAmountHint').hide();
            $('#editAmount').attr('min', '0');
            $('#editChargeType').attr('required', 'required');
            $('.edit-modal-title').html('<i class="fas fa-edit mr-2"></i>Edit Service Charge');

            var typeFound = false;
            $('#editChargeType option').each(function() {
                if ($(this).val() === chargeType) {
                    typeFound = true;
                }
            });
            if (typeFound) {
                $('#editChargeType').val(chargeType);
                $('#editCustomChargeType').hide();
            } else {
                $('#editChargeType').val('Other');
                $('#editCustomChargeType').show();
                $('#editCustomChargeInput').val(chargeType);
            }

            $('#editPaymentMethod option').each(function() {
                if ($(this).val() === paymentMethod || $(this).attr('data-name') === paymentMethod) {
                    $(this).prop('selected', true);
                }
            });

            toggleEditPaymentFields();
        }

        $('#editChargeModal').modal('show');
    });

    $('#editChargeType').on('change', function() {
        $('#editCustomChargeType').toggle($(this).val() === 'Other');
    });


});

function toggleSvcPaymentFields() {
    var sel = document.getElementById('svcPaymentMethod');
    var name = sel.options[sel.selectedIndex]?.getAttribute('data-name') || '';
    var isCash = name.indexOf('cash') !== -1;
    var isOnline = !isCash && name !== '';

    document.getElementById('svc_online_fields').style.display = isOnline ? 'block' : 'none';
    document.getElementById('svc_receipt_field').style.display = isCash ? 'block' : 'none';

    if (isOnline) {
        var label = 'Sender Number';
        if (name.indexOf('bkash') !== -1) label = 'bKash Number';
        else if (name.indexOf('nagad') !== -1) label = 'Nagad Number';
        else if (name.indexOf('rocket') !== -1) label = 'Rocket Number';
        document.getElementById('svc_number_label').textContent = label;
    }
}


function toggleEditPaymentFields() {
    var sel = document.getElementById('editPaymentMethod');
    if (!sel) return;
    var name = sel.options[sel.selectedIndex]?.getAttribute('data-name') || '';
    var isCash = name.indexOf('cash') !== -1;
    var isOnline = !isCash && name !== '';

    document.getElementById('edit_online_fields').style.display = isOnline ? 'block' : 'none';
    document.getElementById('edit_receipt_field').style.display = isCash ? 'block' : 'none';

    if (isOnline) {
        var label = 'Sender Number';
        if (name.indexOf('bkash') !== -1) label = 'bKash Number';
        else if (name.indexOf('nagad') !== -1) label = 'Nagad Number';
        else if (name.indexOf('rocket') !== -1) label = 'Rocket Number';
        document.getElementById('edit_number_label').textContent = label;
    }
}
</script>
@endpush
