}
.cp-sticky-bar .sticky-avatar img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
}
.cp-sticky-bar .sticky-name {
    font-size: 15px;
    font-weight: 700;
}
.cp-sticky-bar .sticky-meta {
    font-size: 11px;
    opacity: 0.8;
}
.cp-sticky-bar .sticky-right {
    display: flex;
