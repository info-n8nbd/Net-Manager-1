}
.cp-bill-payment:last-child { border-bottom: none; }

.cp-status-timeline {
    position: relative;
    padding-left: 24px;
}
.cp-status-timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: #e9ecef;
}
.cp-timeline-item {
    position: relative;
    padding: 10px 0 10px 16px;
}
.cp-timeline-dot {
    position: absolute;
    left: -20px;
    top: 14px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 3px solid #fff;
    box-shadow: 0 0 0 2px #e9ecef;
}
.cp-timeline-dot.active { background: var(--cp-success); box-shadow: 0 0 0 2px var(--cp-success); }
.cp-timeline-dot.inactive { background: var(--cp-danger); box-shadow: 0 0 0 2px var(--cp-danger); }

.cp-fiber-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
}
.cp-fiber-item {
    display: flex;
    justify-content: space-between;
