}
.cp-sticky-bar .sticky-actions {
    display: flex;
    gap: 6px;
    margin-left: 10px;
}
.cp-sticky-bar .sticky-actions .btn {
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.25);
    color: #fff;
