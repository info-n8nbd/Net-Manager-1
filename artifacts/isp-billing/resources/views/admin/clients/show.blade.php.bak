<style>
:root {
    --cp-primary: #007bff;
    --cp-success: #28a745;
    --cp-danger: #dc3545;
    --cp-warning: #ffc107;
    --cp-info: #17a2b8;
    --cp-dark: #343a40;
    --cp-light: #f8f9fa;
    --cp-border: #e9ecef;
    --cp-text: #495057;
    --cp-text-light: #8898aa;
    --cp-radius: 12px;
    --cp-shadow: 0 2px 12px rgba(0,0,0,0.08);
    --cp-shadow-hover: 0 6px 20px rgba(0,0,0,0.12);
}

.cp-hero {
    background: linear-gradient(135deg, #2a5298 0%, #2a5298 100%);
    border-radius: var(--cp-radius);
    padding: 18px 22px;
    color: #fff;
    margin-bottom: 14px;
    position: relative;
    overflow: hidden;
    box-shadow: var(--cp-shadow);
}
.cp-hero::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 400px;
    height: 400px;
    background: rgba(255,255,255,0.05);
    border-radius: 50%;
}
.cp-hero::after {
    content: '';
    position: absolute;
    bottom: -30%;
    left: -10%;
    width: 250px;
    height: 250px;
    background: rgba(255,255,255,0.03);
    border-radius: 50%;
}
.cp-hero-content { position: relative; z-index: 1; }
.cp-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 3px solid rgba(255,255,255,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    font-weight: 600;
    background: rgba(255,255,255,0.15);
    color: #fff;
    flex-shrink: 0;
}
.cp-avatar img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
}
.cp-hero-name { font-size: 19px; font-weight: 700; margin-bottom: 1px; }
.cp-hero-meta { font-size: 12px; opacity: 0.85; }
.cp-hero-badges { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 5px; }
.cp-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.3px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.25);
}
.cp-badge-active { background: #28a745; color: #fff; }
.cp-badge-inactive { background: #dc3545; color: #fff; }
.cp-badge-online { background: #17a2b8; color: #fff; }
.cp-badge-offline { background: rgba(255,255,255,0.2); color: #fff; border: 1.5px solid rgba(255,255,255,0.4); box-shadow: none; }
.cp-badge-free { background: #ffc107; color: #212529; }
.cp-badge-manual-hold { background: linear-gradient(135deg, #6f42c1, #9b59b6); color: #fff; animation: manualHoldPulse 2.5s ease-in-out infinite; }
@keyframes manualHoldPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(111,66,193,0.5); }
    50%       { box-shadow: 0 0 0 5px rgba(111,66,193,0); }
}
.cp-badge-live { background: linear-gradient(135deg, #11998e, #38ef7d); color: #fff; box-shadow: 0 0 10px rgba(40,211,100,0.4); }
@keyframes livePulse {
    0%   { transform: scale(1);   opacity: 1; box-shadow: 0 0 0 0 rgba(40,211,100,0.6); }
    50%  { transform: scale(1.3); opacity: 0.8; box-shadow: 0 0 0 5px rgba(40,211,100,0); }
    100% { transform: scale(1);   opacity: 1; box-shadow: 0 0 0 0 rgba(40,211,100,0); }
}
.live-dot {
    display: inline-block;
    width: 8px; height: 8px;
    background: #fff;
    border-radius: 50%;
    animation: livePulse 1.4s ease-in-out infinite;
}

.cp-hero-actions {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 8px;
}
.cp-hero-actions .btn {
    border-radius: 6px;
    font-size: 12px;
    padding: 4px 10px;
    border: 1px solid rgba(255,255,255,0.25);
    color: #fff;
    background: rgba(255,255,255,0.1);
    transition: all 0.2s;
}
.cp-hero-actions .btn:hover {
    background: rgba(255,255,255,0.2);
    color: #fff;
    transform: translateY(-1px);
}


.cp-card {
    background: #fff;
    border-radius: 10px;
    box-shadow: var(--cp-shadow);
    margin-bottom: 14px;
    border: 1px solid var(--cp-border);
    overflow: hidden;
}
.cp-card-header {
    padding: 10px 16px;
    border-bottom: 1px solid var(--cp-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #fff;
}
.cp-card-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--cp-dark);
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
}
.cp-card-title i {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
}
.cp-card-body { padding: 12px 16px; }
.cp-card-header.cp-collapsible { cursor: pointer; user-select: none; }
.cp-card-header.cp-collapsible:hover { background: #f8f9fc; }
.cp-collapse-icon { transition: transform 0.25s ease; font-size: 12px; color: var(--cp-text-light); margin-left: 8px; }
.cp-collapse-icon.collapsed { transform: rotate(-90deg); }
.cp-card-collapse { transition: max-height 0.3s ease, opacity 0.2s ease; overflow: hidden; }
.cp-card-collapse.collapsed { max-height: 0 !important; opacity: 0; }

.cp-info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
}
.cp-info-item {
    display: flex;
    align-items: flex-start;
    padding: 6px 12px;
    border-bottom: 1px solid #f1f3f5;
    transition: background 0.15s;
}
.cp-info-item:hover { background: #f8f9fa; }
.cp-info-label {
    font-size: 13px;
    color: var(--cp-text-light);
    font-weight: 500;
    min-width: 120px;
    flex-shrink: 0;
}
.cp-info-value {
    font-size: 13px;
    color: var(--cp-dark);
    font-weight: 500;
    word-break: break-word;
}
.cp-info-value a { color: var(--cp-primary); text-decoration: none; }
.cp-info-value a:hover { text-decoration: underline; }
.cp-info-value code {
    background: #f1f3f5;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 12px;
    color: var(--cp-dark);
}

.cp-conn-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
}
.cp-conn-pill {
    flex: 1;
    min-width: 100px;
    background: linear-gradient(135deg, #f8f9fa 0%, #fff 100%);
    border: 1px solid var(--cp-border);
    border-radius: 8px;
    padding: 8px 10px;
    text-align: center;
    transition: all 0.2s;
}
.cp-conn-pill:hover { border-color: var(--cp-primary); box-shadow: 0 2px 8px rgba(0,123,255,0.1); }
.cp-conn-pill-label { font-size: 11px; color: var(--cp-text-light); text-transform: uppercase; letter-spacing: 0.3px; font-weight: 600; }
.cp-conn-pill-value { font-size: 14px; font-weight: 700; color: var(--cp-dark); margin-top: 3px; }

.cp-device-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-radius: 8px;
    border: 1px solid var(--cp-border);
    background: #fff;
