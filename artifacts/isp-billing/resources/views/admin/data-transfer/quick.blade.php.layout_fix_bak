    e.target.nextElementSibling.textContent = fileName;
});

document.getElementById('quickImportForm').addEventListener('submit', function() {
    document.getElementById('importBtn').innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Importing...';
    document.getElementById('importBtn').disabled = true;
});
</script>
