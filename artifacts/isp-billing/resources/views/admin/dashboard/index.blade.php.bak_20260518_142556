                                /* track arc */
                                ctx.beginPath();
                                ctx.arc(cx2,cy2,R,-Math.PI*0.75,Math.PI*0.75);
                                ctx.strokeStyle=v>0?'#e8f4fd':'#f1f5f9';
                                ctx.lineWidth=5.5; ctx.lineCap='round'; ctx.stroke();
