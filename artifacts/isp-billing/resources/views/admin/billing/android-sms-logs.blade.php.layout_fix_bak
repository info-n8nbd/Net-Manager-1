<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
function showSms(id) {
    var row = document.getElementById('sms-row-' + id);
    row.style.display = row.style.display === 'none' ? 'table-row' : 'none';
}

function openReprocess(id, ref, amount, gateway, sender, trxid, rawSms) {
    // Reset
    document.getElementById('reprocessRef').value = ref || '';
    document.getElementById('reprocessClientId').value = '';
    document.getElementById('reprocessForm').action = '/admin/billing/android-sendmoney/reprocess/' + id;
    document.getElementById('reprocessForm').dataset.logId = id;

    // Populate SMS info
    document.getElementById('modal-amount').textContent = amount ? 'Tk ' + parseFloat(amount).toLocaleString() : '-';
    // Show manual amount input if amount is missing
    var manualRow = document.getElementById('manual-amount-row');
    var amountHidden = document.getElementById('reprocessAmountHidden');
    if (!amount) {
        manualRow.style.display = 'block';
        document.getElementById('reprocessAmount').value = '';
        amountHidden.value = '';
        document.getElementById('reprocessAmount').setAttribute('required', 'required');
    } else {
        manualRow.style.display = 'none';
        document.getElementById('reprocessAmount').removeAttribute('required');
        amountHidden.value = amount;
    }
    document.getElementById('modal-gateway').textContent = gateway || '-';
    document.getElementById('modal-sender').textContent = sender || '-';
    document.getElementById('modal-trxid').textContent = trxid || '-';
    document.getElementById('modal-ref').textContent = ref || '(none)';
    document.getElementById('modal-raw-sms').textContent = rawSms || '-';

    // Reset Select2
    if ($('#clientSearchSelect').data('select2')) {
        $('#clientSearchSelect').val(null).trigger('change');
    }

    $('#reprocessModal').modal('show');
}

function copyText(id) {
    var el = document.getElementById(id);
    el.select();
    document.execCommand('copy');
    toastr.success('Copied!');
}

$(document).ready(function() {
    // Initialize Select2 for client search
    $('#clientSearchSelect').select2({
        dropdownParent: $('#reprocessModal'),
        placeholder: 'Search by name / Client ID / phone...',
        minimumInputLength: 2,
        allowClear: true,
        ajax: {
            url: '/admin/api/search-clients',
            dataType: 'json',
            delay: 300,
            data: function(params) {
                return { q: params.term };
            },
            processResults: function(data) {
                return {
                    results: data.map(function(c) {
                        return {
                            id: c.id,
                            text: c.name + ' (' + (c.client_id || c.username) + ')' + (c.phone ? ' - ' + c.phone : '')
                        };
                    })
                };
            }
        }
    });

    // When client is selected, set hidden input
    $('#clientSearchSelect').on('select2:select', function(e) {
        document.getElementById('reprocessClientId').value = e.params.data.id;
    });
    $('#clientSearchSelect').on('select2:unselect', function() {
        document.getElementById('reprocessClientId').value = '';
    });

    // AJAX form submit — remove row immediately on success
    $('#reprocessForm').on('submit', function(e) {
        e.preventDefault();
        var form = this;
        var logId = form.dataset.logId;
        var $btn = $(form).find('button[type=submit]');
        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i>Processing...');

        $.ajax({
            url: form.action,
            method: 'POST',
            data: $(form).serialize(),
            dataType: 'json',
            success: function(res) {
                if (res.success) {
                    $('#reprocessModal').modal('hide');
                    // Remove row from pending list
                    var $row = $('#log-row-' + logId);
                    var $rawRow = $('#sms-row-' + logId);
                    $row.fadeOut(300, function() { $(this).remove(); });
                    $rawRow.remove();
                    // Update manual applied stat count
                    var $statCount = $('#manualStatCount');
                    $statCount.text(parseInt($statCount.text() || 0) + 1);
                    toastr.success('Payment of Tk ' + (res.amount ? parseFloat(res.amount).toLocaleString() : '?') + ' applied to ' + (res.client_name || 'client') + ' successfully!');
                } else {
                    toastr.error(res.message || 'Failed to apply payment.');
                    $btn.prop('disabled', false).html('<i class="fas fa-check mr-1"></i>Apply Payment');
                }
            },
            error: function(xhr) {
                var msg = 'Server error. Please try again.';
                try { msg = xhr.responseJSON.message || msg; } catch(ex) {}
                toastr.error(msg);
                $btn.prop('disabled', false).html('<i class="fas fa-check mr-1"></i>Apply Payment');
            }
        });
    });
});

function toggleLock(id, btn) {
    fetch('/admin/billing/android-sendmoney/' + id + '/lock', {
        method: 'POST',
        headers: {
            'X-CSRF-TOKEN': document.querySelector('meta[name=csrf-token]').content,
            'Content-Type': 'application/json',
            'Accept': 'application/json'
        }
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            const icon = btn.querySelector('i');
            // Find the apply button in the same cell
            const applyBtn = btn.parentElement.querySelector('.apply-btn');

            if (data.locked) {
                // Locked — style button red, hide apply button
                btn.classList.remove('btn-secondary');
                btn.classList.add('btn-danger', 'lock-btn');
                btn.title = 'Locked by you — click to unlock';
                icon.classList.remove('fa-unlock');
                icon.classList.add('fa-lock');
                if (applyBtn) applyBtn.style.display = 'none';
            } else {
                // Unlocked — style button grey, show apply button
                btn.classList.remove('btn-danger');
                btn.classList.add('btn-secondary');
                btn.title = 'Lock to reserve (hides Apply button)';
                icon.classList.remove('fa-lock');
                icon.classList.add('fa-unlock');
                if (applyBtn) applyBtn.style.display = '';
            }
        } else {
            alert(data.message || 'Could not toggle lock');
        }
    })
    .catch(() => alert('Network error'));
}

</script>
