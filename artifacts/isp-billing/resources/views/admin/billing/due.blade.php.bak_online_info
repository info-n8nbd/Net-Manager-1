<script>
function dueColSort(col, defaultDir) {
    var url = new URL(window.location.href);
    var cur = url.searchParams.get('sort_by') || '';
    var dir = url.searchParams.get('sort_dir') || defaultDir;
    url.searchParams.set('sort_by', col);
    url.searchParams.set('sort_dir', cur === col ? (dir === 'asc' ? 'desc' : 'asc') : defaultDir);
    url.searchParams.delete('page');
    window.location.href = url.toString();
}

// Action dropdown portal fix (same as client list)
(function(){
    var $active = null, $origParent = null;
    $(document).on('show.bs.dropdown', '#dueBillsTable .action-btns .dropdown', function(){
        var $toggle = $(this).find('.dropdown-toggle');
        var $menu   = $(this).find('.dropdown-menu');
        $origParent = $menu.parent();
        $menu.appendTo('body');
        $active = $menu;
        function pos(){
            var r = $toggle[0].getBoundingClientRect();
            $menu.css({ position:'absolute', top:(r.bottom+window.scrollY+2)+'px', left:(r.right+window.scrollX-$menu.outerWidth())+'px', display:'block', zIndex:99999 });
        }
        pos();
        $(window).on('scroll.dueDD resize.dueDD', pos);
    });
    $(document).on('hide.bs.dropdown', '#dueBillsTable .action-btns .dropdown', function(){
        if ($active && $origParent) {
            $active.css({ display:'', position:'', top:'', left:'', zIndex:'' });
            $active.appendTo($origParent);
            $active = null; $origParent = null;
        }
        $(window).off('scroll.dueDD resize.dueDD');
    });
})();
</script>
