                </div>
            </div>
        </div>
    </div>
</div>
<script>
// ─── ONU Picker for Application Review ────────────────────────────────────────
(function() {
    var _appCachedOnus = null;

    document.getElementById('btnAppPickOnu') && document.getElementById('btnAppPickOnu').addEventListener('click', function() {
        _appCachedOnus = null;
        $('#appOnuPickerModal').modal('show');
        appLoadOnuPickerList();
    });

    document.getElementById('appOnuPickerSearchBtn') && document.getElementById('appOnuPickerSearchBtn').addEventListener('click', function() {
        appLoadOnuPickerList();
    });

    document.getElementById('appOnuPickerSearch') && document.getElementById('appOnuPickerSearch').addEventListener('keypress', function(e) {
        if (e.which === 13) { e.preventDefault(); appLoadOnuPickerList(); }
    });

    document.getElementById('app_onu_serial') && (function() {
        var s = document.getElementById('app_onu_serial').value;
        if (s) document.getElementById('btnAppUnselectOnu') && (document.getElementById('btnAppUnselectOnu').style.display = '');
    })();

    window.appLoadOnuPickerList = function() {
        if (_appCachedOnus && _appCachedOnus.length > 0) {
            appRenderOnuTable(_appCachedOnus);
            return;
        }
        $('#appOnuPickerLoading').show();
        $('#appOnuPickerBody').html('');
        var search = encodeURIComponent(document.getElementById('appOnuPickerSearch').value || '');
        var unassigned = document.getElementById('appOnuPickerUnassignedOnly').checked ? '1' : '0';
        var xhr = new XMLHttpRequest();
        xhr.open('GET', '/admin/network/onus/picker-list?search=' + search + '&unassigned_only=' + unassigned, true);
        xhr.setRequestHeader('Accept', 'application/json');
        xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
        xhr.timeout = 15000;
        xhr.onload = function() {
            $('#appOnuPickerLoading').hide();
            try {
                var res = JSON.parse(xhr.responseText);
                if (res.success && res.data && res.data.length > 0) {
                    _appCachedOnus = res.data;
                    appRenderOnuTable(res.data);
                } else if (res.success) {
                    $('#appOnuPickerBody').html('<tr><td colspan="8" class="text-center text-muted py-3"><i class="fas fa-info-circle mr-2"></i>No ONUs found. Run OLT Scan first.</td></tr>');
                } else {
                    $('#appOnuPickerBody').html('<tr><td colspan="8" class="text-center text-danger py-3">' + (res.message || 'Error') + '</td></tr>');
                }
            } catch(e) {
                $('#appOnuPickerBody').html('<tr><td colspan="8" class="text-center text-danger py-3">Failed to load ONU list.</td></tr>');
            }
        };
        xhr.onerror = function() { $('#appOnuPickerLoading').hide(); $('#appOnuPickerBody').html('<tr><td colspan="8" class="text-center text-danger py-3">Network error.</td></tr>'); };
        xhr.ontimeout = function() { $('#appOnuPickerLoading').hide(); $('#appOnuPickerBody').html('<tr><td colspan="8" class="text-center text-danger py-3">Timeout.</td></tr>'); };
        xhr.send();
    };

    window.appRenderOnuTable = function(onus) {
        var search = (document.getElementById('appOnuPickerSearch').value || '').toLowerCase();
        var unassignedOnly = document.getElementById('appOnuPickerUnassignedOnly').checked;
        var html = '';
        var count = 0;
        onus.forEach(function(o) {
            if (unassignedOnly && o.client_id) return;
            if (search && !(
                (o.serial_number||'').toLowerCase().indexOf(search) >= 0 ||
                (o.mac_address||'').toLowerCase().indexOf(search) >= 0 ||
                (o.pon_port||'').toLowerCase().indexOf(search) >= 0 ||
                (o.model||'').toLowerCase().indexOf(search) >= 0
            )) return;
            var statusBadge = o.status === 'online'
                ? '<span class="badge badge-success" style="font-size:11px;">Online</span>'
                : '<span class="badge badge-secondary" style="font-size:11px;">Offline</span>';
            var clientInfo = o.client_username
                ? '<span class="badge badge-warning" style="font-size:11px;"><i class="fas fa-user mr-1"></i>' + o.client_username + '</span>'
                : '<span class="text-muted" style="font-size:11px;">—</span>';
            var rxStr = o.rx_power !== null ? o.rx_power + ' dBm' : '—';
            var rxColor = o.rx_power !== null ? (o.rx_power >= -15 ? 'color:#28a745' : (o.rx_power >= -20 ? 'color:#17a2b8' : 'color:#ffc107')) : '';
            html += '<tr style="cursor:pointer;" onclick=\'appPickOnu(' + JSON.stringify(o).replace(/'/g, "\\'") + ')\'>';
            html += '<td><code style="font-size:12px;">' + (o.serial_number || '—') + '</code></td>';
            html += '<td><code style="font-size:11px;">' + (o.mac_address || '—') + '</code></td>';
            html += '<td><strong class="text-success">' + (o.pon_port || '—') + '</strong></td>';
            html += '<td>' + (o.model || '—') + '</td>';
            html += '<td style="' + rxColor + '; font-weight:600;">' + rxStr + '</td>';
            html += '<td>' + statusBadge + '</td>';
            html += '<td>' + clientInfo + '</td>';
            html += '<td><button type="button" class="btn btn-xs btn-success" style="white-space:nowrap;padding:2px 8px;font-size:12px;"><i class="fas fa-check mr-1"></i>Select</button></td>';
            html += '</tr>';
            count++;
        });
        if (!count) html = '<tr><td colspan="8" class="text-center text-muted py-3">No matching ONUs found.</td></tr>';
        document.getElementById('appOnuPickerBody').innerHTML = html;
    };

    window.appPickOnu = function(o) {
        if (o.serial_number) document.getElementById('app_onu_serial').value = o.serial_number;
        if (o.mac_address)   document.getElementById('app_onu_mac').value   = o.mac_address;
        if (o.pon_port)      document.getElementById('app_olt_port').value   = o.pon_port;
        if (o.model)         document.getElementById('app_onu_model').value  = o.model;
        if (o.olt_device_id) document.getElementById('app_olt_device_id').value = o.olt_device_id;
        $('#appOnuPickerModal').modal('hide');
        document.getElementById('btnAppUnselectOnu').style.display = '';
        var serial = document.getElementById('app_onu_serial');
        serial.style.borderColor = '#28a745';
        serial.style.boxShadow = '0 0 0 0.2rem rgba(40,167,69,0.25)';
        setTimeout(function() { serial.style.borderColor = ''; serial.style.boxShadow = ''; }, 3000);
        if (typeof toastr !== 'undefined') toastr.success('ONU "' + (o.serial_number || o.mac_address) + '" selected!', 'ONU Selected');
    };

    window.appUnselectOnu = function() {
        if (!window.Swal) {
            if (!confirm('Clear ONU selection?')) return;
            document.getElementById('app_onu_serial').value = '';
            document.getElementById('app_onu_mac').value = '';
            document.getElementById('app_olt_port').value = '';
            document.getElementById('app_onu_model').value = '';
            document.getElementById('app_olt_device_id').value = '';
            document.getElementById('btnAppUnselectOnu').style.display = 'none';
            return;
        }
        Swal.fire({
            title: 'Unselect ONU?',
            text: 'ONU Serial, MAC, Port and Model will be cleared.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            confirmButtonText: 'Yes, Clear',
        }).then(function(r) {
            if (r.isConfirmed) {
                document.getElementById('app_onu_serial').value = '';
                document.getElementById('app_onu_mac').value = '';
                document.getElementById('app_olt_port').value = '';
                document.getElementById('app_onu_model').value = '';
                document.getElementById('app_olt_device_id').value = '';
                document.getElementById('btnAppUnselectOnu').style.display = 'none';
                if (typeof toastr !== 'undefined') toastr.info('ONU cleared.', 'ONU Unselected');
            }
        });
    };

    window.appScanOltAndRefresh = function() {
        if (typeof toastr !== 'undefined') toastr.info('OLT Scan triggered. Reload list in a moment.', 'OLT Scan');
        _appCachedOnus = null;
        setTimeout(appLoadOnuPickerList, 2000);
    };
})();
</script>
@endsection
