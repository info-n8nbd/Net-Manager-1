<script>
document.addEventListener('DOMContentLoaded', function() {
    var codeField = document.getElementById('client_code_field');
    var passField = document.getElementById('pppoe_password_field');
    if (codeField && passField) {
        codeField.addEventListener('input', function() {
            passField.value = this.value;
        });
    }
});
</script>
@endsection
