<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Invoice {{ $bill->bill_no }}</title>
@php $isPdfMode = isset($isPdf) && $isPdf; @endphp
<style>
* { margin:0; padding:0; box-sizing:border-box; }

@if($isPdfMode)
/* ===== PDF / DomPDF mode ===== */
@page { size: A4 portrait; margin: 0; }
body {
    font-family: DejaVu Sans, Arial, sans-serif;
    font-size: 11px;
    color: #222;
    background: #fff;
    padding: 10mm 12mm 10mm 12mm;
    width: 210mm;
}
@else
/* ===== Browser / Screen mode ===== */
body {
    font-family: Arial, sans-serif;
    font-size: 11px;
    color: #222;
    background: #6b7280;
    min-height: 100vh;
    padding: 24px 0;
}
.page {
    width: 210mm;
    min-height: 297mm;
    background: #fff;
    margin: 0 auto;
    padding: 10mm 12mm;
    box-shadow: 0 4px 28px rgba(0,0,0,.4);
    border-radius: 2px;
}
@media print {
    body { background: #fff; padding: 0; }
    .page { box-shadow: none; border-radius: 0; width: 100%; min-height: auto; padding: 10mm 12mm; }
}
@endif

/* ===== Shared styles ===== */
.hdr-tbl { width:100%; border-collapse:collapse; margin-bottom:5px; page-break-inside:avoid; }
.hdr-tbl td { vertical-align:top; padding:0; }
.co-name { font-size:15px; font-weight:700; color:#1a3a5c; }
.co-sub  { font-size:9.5px; color:#555; line-height:1.6; margin-top:2px; }
.inv-label { font-size:20px; font-weight:700; color:#1a3a5c; text-transform:uppercase; letter-spacing:2px; text-align:right; }
.inv-meta  { text-align:right; font-size:11px; margin-top:4px; line-height:1.7; }
.inv-meta b { color:#1a3a5c; }
.hdiv { border-top:2.5px solid #1a3a5c; margin:5px 0; }

.badge { padding:2px 6px; border-radius:2px; font-size:8.5px; font-weight:700; text-transform:uppercase; }
.b-paid    { background:#d5f5e3; color:#1e8449; border:1px solid #1e8449; }
.b-partial { background:#fef9e7; color:#b7950b; border:1px solid #b7950b; }
.b-unpaid  { background:#fadbd8; color:#c0392b; border:1px solid #c0392b; }

.two-tbl { width:100%; border-collapse:collapse; margin-bottom:7px; page-break-inside:avoid; }
.two-tbl td { vertical-align:top; }

.bill-to-box { background:#f5f7fa; border:1px solid #d5d8dc; border-radius:3px; padding:8px 10px; }
.bill-to-box .lbl { font-size:9px; text-transform:uppercase; letter-spacing:1px; color:#888; font-weight:700; border-bottom:1px solid #ddd; padding-bottom:3px; margin-bottom:4px; }
.bill-to-box p { margin:2px 0; font-size:11px; }
.bill-to-box p span { color:#666; }

.sum-box { background:#f5f7fa; border:1px solid #d5d8dc; border-radius:3px; padding:8px 10px; }
.sum-box .lbl { font-size:9px; text-transform:uppercase; letter-spacing:1px; color:#888; font-weight:700; border-bottom:1px solid #ddd; padding-bottom:3px; margin-bottom:4px; }
.sum-tbl { width:100%; border-collapse:collapse; }
.sum-tbl td { padding:2px 0; font-size:11px; }
.sum-tbl td.sr { text-align:right; font-weight:600; }
.sum-tbl tr.s-total td { font-weight:700; font-size:12px; color:#1a3a5c; border-top:1px solid #ccc; padding-top:3px; }
.sum-tbl tr.s-due td   { font-weight:700; font-size:12px; color:#c0392b; }
.sum-tbl tr.s-paid td  { color:#1e8449; font-weight:700; }
.sum-tbl tr.s-close td { color:#666; }

.sec { font-size:9.5px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#1a3a5c; border-left:3px solid #1a3a5c; padding:2px 0 2px 7px; margin:7px 0 4px; page-break-after:avoid; }

table.dt { width:100%; border-collapse:collapse; font-size:11px; margin-bottom:6px; }
table.dt thead { display:table-header-group; }
table.dt th { background:#1a3a5c; color:#fff; padding:4px 6px; text-align:left; font-size:9.5px; text-transform:uppercase; letter-spacing:0.3px; white-space:nowrap; }
table.dt th.r, table.dt td.r { text-align:right; }
table.dt th.c, table.dt td.c { text-align:center; }
table.dt td { padding:3.5px 6px; border-bottom:1px solid #e8e8e8; }
table.dt tr { page-break-inside:avoid; }
table.dt tr:nth-child(even) td { background:#f8f9fa; }
table.dt tfoot td { background:#e8edf5; font-weight:700; border-top:2px solid #1a3a5c; padding:3.5px 6px; font-size:11px; }

table.at th       { background:#7d3c98; }
table.at tfoot td { background:#f5eef8; border-top:2px solid #7d3c98; }
tr.seg td { font-size:9.5px; color:#666; background:#fffde7 !important; padding:2px 6px 2px 20px; font-style:italic; }

table.pt th       { background:#1e6b3c; }
table.pt tfoot td { background:#eafaf1; border-top:2px solid #1e6b3c; }

.ftr { width:100%; border-collapse:collapse; border-top:1px solid #ddd; margin-top:10px; page-break-inside:avoid; }
.ftr td { vertical-align:bottom; font-size:9.5px; color:#888; padding-top:6px; }
.sig-line { border-top:1px solid #888; width:130px; margin:22px 0 3px; margin-left:auto; }
.no-upper { text-transform:none !important; }
</style>
</head>
