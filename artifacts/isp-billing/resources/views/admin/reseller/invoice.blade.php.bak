            <tr class="s-close"><td>Closing Balance</td><td class="sr">BDT {{ number_format($bill->closing_balance,2) }}</td></tr>
        </tbody></table>
    </div>
</td>
</tr></tbody></table>

{{-- BANDWIDTH BREAKDOWN --}}
@if(!empty($bill->bandwidth_breakdown) && count($bill->bandwidth_breakdown)>0)
<div class="sec">Bandwidth Allocation Breakdown</div>
<table class="dt"><thead>
    <tr>
        <th>Category</th>
        <th class="r no-upper" style="width:65px;">Mbps</th>
        <th class="r no-upper" style="width:105px;">Rate (BDT/Mbps)</th>
        <th class="r" style="width:100px;">Subtotal (BDT)</th>
    </tr>
</thead><tbody>
@php $bwTotal=0; @endphp
@foreach($bill->bandwidth_breakdown as $cat)
@php $bwTotal += $cat['subtotal']??0; $hasSegs = !empty($cat['segments']); @endphp
<tr>
    <td>{{ $cat['label']??$cat['category']??'-' }}{{ !empty($cat['prorated'])?' *':'' }}</td>
    <td class="r">{{ number_format($cat['mbps']??0,2) }}</td>
    <td class="r">{{ number_format($cat['rate']??0,2) }}</td>
    <td class="r"><b>{{ number_format($cat['subtotal']??0,2) }}</b></td>
</tr>
@if($hasSegs)
@foreach($cat['segments'] as $seg)
<tr class="seg">
    <td colspan="2">&#x21B3; {{ $seg['from'] }} - {{ $seg['to'] }} ({{ $seg['days'] }} days @ {{ $seg['mbps'] }} Mbps)</td>
    <td class="r">{{ number_format($seg['rate'],2) }}</td>
    <td class="r">{{ number_format($seg['amount'],2) }}</td>
</tr>
@endforeach
@endif
@endforeach
</tbody><tfoot>
    <tr><td colspan="3" class="r">Total Bandwidth Charge</td><td class="r">BDT {{ number_format($bwTotal,2) }}</td></tr>
</tfoot></table>
@if($bwTotal != $bill->total_recharge)<p style="font-size:9.5px;color:#888;margin-bottom:4px;">* Pro-rated due to mid-month adjustment</p>@endif
@endif

