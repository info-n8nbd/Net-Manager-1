<script>
function addTypeRow() {
    var html = '<div class="input-group mb-2 type-row">';
    html += '<input type="text" name="types[]" class="form-control form-control-sm" placeholder="Type name">';
    html += '<div class="input-group-append">';
    html += '<button type="button" class="btn btn-sm btn-danger" onclick="removeTypeRow(this)" title="Remove"><i class="fas fa-times"></i></button>';
    html += '</div></div>';
    document.getElementById('typeFields').insertAdjacentHTML('beforeend', html);
}

function removeTypeRow(btn) {
    var rows = document.querySelectorAll('.type-row');
    if (rows.length > 1) {
        btn.closest('.type-row').remove();
    } else {
        btn.closest('.type-row').querySelector('input').value = '';
    }
}

function openEditModal(id, name, desc, parentId, hasSerial) {
    document.getElementById('editCategoryForm').action = '{{ url("admin/inventory/instrument-categories") }}/' + id;
    document.getElementById('editCategoryName').value = name;
    document.getElementById('editCategoryDesc').value = desc || '';

    var parentSelect = document.getElementById('editParentId');
    for (var i = 0; i < parentSelect.options.length; i++) {
        var opt = parentSelect.options[i];
        if (opt.value == id) {
            opt.disabled = true;
            opt.style.display = 'none';
        } else {
            opt.disabled = false;
            opt.style.display = '';
        }
    }
    parentSelect.value = parentId || '';

    if (parentId) {
        document.getElementById('editSerialGroup').style.display = 'none';
    } else {
        document.getElementById('editSerialGroup').style.display = 'block';
        document.getElementById('editHasSerial').checked = hasSerial ? true : false;
    }
    $('#editCategoryModal').modal('show');
}

function openAddTypeModal(parentId, parentName) {
    document.getElementById('addTypeParentId').value = parentId;
    document.getElementById('addTypeParentName').textContent = parentName;
    $('#addTypeModal').modal('show');
}
</script>
