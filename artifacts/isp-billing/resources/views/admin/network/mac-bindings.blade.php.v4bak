@push('scripts')
<script>
const csrfToken = document.querySelector('meta[name="csrf-token"]').content;

function toggleSelectAll(el) {
    document.querySelectorAll('.client-check').forEach(cb => cb.checked = el.checked);
    updateBulkBtn();
}

function updateBulkBtn() {
    const checked = document.querySelectorAll('.client-check:checked').length;
    document.getElementById('bulkBindBtn').disabled = checked === 0;
}

function toggleBinding(clientId) {
    const btn = document.getElementById('toggle-btn-' + clientId);
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

    fetch('{{ url("admin/network/mac-bindings") }}/' + clientId + '/toggle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken },
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            const bound = data.bound;
            document.getElementById('binding-status-' + clientId).innerHTML = bound
                ? '<span class="badge badge-success"><i class="fas fa-lock mr-1"></i>Bound</span>'
                : '<span class="badge badge-secondary"><i class="fas fa-lock-open mr-1"></i>Unbound</span>';
            btn.className = 'btn btn-xs btn-' + (bound ? 'danger' : 'success');
            btn.innerHTML = '<i class="fas fa-' + (bound ? 'unlock' : 'lock') + ' mr-1"></i>' + (bound ? 'Unbind' : 'Bind');
        }
        btn.disabled = false;
    })
    .catch(() => { btn.disabled = false; btn.innerHTML = 'Error'; });
}

function editMac(clientId, currentMac) {
    document.getElementById('mac-display-' + clientId).style.display = 'none';
    document.getElementById('mac-edit-' + clientId).style.display = 'inline-block';
    document.getElementById('mac-input-' + clientId).value = currentMac;
    document.getElementById('mac-input-' + clientId).focus();
}

function cancelEditMac(clientId) {
    document.getElementById('mac-display-' + clientId).style.display = 'inline';
    document.getElementById('mac-edit-' + clientId).style.display = 'none';
}

function saveMac(clientId) {
    const mac = document.getElementById('mac-input-' + clientId).value.trim();
    const macRegex = /^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$/;
    if (!macRegex.test(mac)) {
        alert('Invalid MAC address format. Use format: AA:BB:CC:DD:EE:FF');
        return;
    }

    fetch('{{ url("admin/network/mac-bindings") }}/' + clientId + '/update-mac', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken },
        body: JSON.stringify({ mac_address: mac })
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            const display = document.getElementById('mac-display-' + clientId);
            display.querySelector('code').textContent = mac.toUpperCase();
            display.querySelector('button').setAttribute('onclick', "editMac(" + clientId + ", '" + mac.toUpperCase() + "')");
            cancelEditMac(clientId);
        } else {
            alert(data.message || 'Failed to update MAC address');
        }
    })
    .catch(() => alert('Error updating MAC address'));
}

function bulkBind() {
    const ids = Array.from(document.querySelectorAll('.client-check:checked')).map(cb => cb.value);
    if (ids.length === 0) return;
    smartConfirm({message:'Bind MAC addresses for '+ids.length+' selected clients?',confirmText:'Bind'},function(){doMacBindNow();}); return;}
function doMacBindNow(){

    const btn = document.getElementById('bulkBindBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i>Processing...';

    fetch('{{ route("admin.network.mac-bulk-bind") }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken },
        body: JSON.stringify({ client_ids: ids })
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            alert(data.message);
            location.reload();
        } else {
            alert(data.message || 'Bulk bind failed');
        }
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-link mr-1"></i>Bulk Bind Selected';
    })
    .catch(() => { btn.disabled = false; btn.innerHTML = '<i class="fas fa-link mr-1"></i>Bulk Bind Selected'; });
}
</script>
@endpush
