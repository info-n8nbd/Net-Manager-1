@push('scripts')
<script>
var oltId = {{ $olt->id }};
var csrfToken = $('meta[name="csrf-token"]').attr('content');

function switchOlt(id) {
    window.location.href = '/admin/network/olt/' + id + '/onus';
}

function doSearch() {
    var val = $('#searchInput').val();
    var url = new URL(window.location.href);
    if (val) { url.searchParams.set('search', val); } else { url.searchParams.delete('search'); }
    window.location.href = url.toString();
}

function checkAllPower() {
    var btn = $('#btnCheckAll');
    var prog = $('#powerProgress');
    var progText = $('#powerProgressText');
    var progBar = $('#powerProgressBar');
    btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i>Checking...');
    prog.removeClass('d-none');
    progBar.css('width', '0%');
    progText.text('Connecting...');

    fetch('/admin/network/olt/' + oltId + '/check-all-power', {
        method: 'POST',
        headers: {
            'X-CSRF-TOKEN': csrfToken,
            'Content-Type': 'application/json'
        }
    }).then(function(response) {
        if (!response.ok) throw new Error('Request failed');
        var contentType = response.headers.get('Content-Type') || '';

        if (contentType.indexOf('text/event-stream') !== -1) {
            var reader = response.body.getReader();
            var decoder = new TextDecoder();
            var buffer = '';

            function read() {
                reader.read().then(function(result) {
                    if (result.done) {
                        btn.prop('disabled', false).html('<i class="fas fa-bolt mr-1"></i>Check All ONU Power');
                        return;
                    }
                    buffer += decoder.decode(result.value, {stream: true});
                    var lines = buffer.split('\n');
                    buffer = lines.pop();
                    lines.forEach(function(line) {
                        if (line.startsWith('data: ')) {
                            try {
                                var data = JSON.parse(line.substring(6));
                                if (data.type === 'start') {
                                    progText.text('0/' + data.total);
                                } else if (data.type === 'progress') {
                                    var pct = Math.round((data.current / data.total) * 100);
                                    progBar.css('width', pct + '%');
                                    progText.text(data.current + '/' + data.total + ' (' + data.updated + ' updated)');
                                } else if (data.type === 'complete') {
                                    btn.prop('disabled', false).html('<i class="fas fa-bolt mr-1"></i>Check All ONU Power');
                                    progBar.css('width', '100%').removeClass('bg-warning').addClass('bg-success');
                                    progText.text('Done! ' + data.updated + '/' + data.total);
                                    Swal.fire('Complete!', data.message, 'success').then(function() { location.reload(); });
                                } else if (data.type === 'error') {
                                    btn.prop('disabled', false).html('<i class="fas fa-bolt mr-1"></i>Check All ONU Power');
                                    progBar.removeClass('bg-warning').addClass('bg-danger');
                                    Swal.fire('Error', data.message, 'error');
                                }
                            } catch(e) {}
                        }
                    });
                    read();
                });
            }
            read();
        } else {
            response.json().then(function(res) {
                btn.prop('disabled', false).html('<i class="fas fa-bolt mr-1"></i>Check All ONU Power');
                prog.addClass('d-none');
                if (res.success) {
                    Swal.fire('Complete!', res.message, 'success').then(function() { location.reload(); });
                } else {
                    Swal.fire('Failed', res.message, 'error');
                }
            });
        }
    }).catch(function(err) {
        btn.prop('disabled', false).html('<i class="fas fa-bolt mr-1"></i>Check All ONU Power');
        prog.addClass('d-none');
        Swal.fire('Error', 'Error checking ONU power: ' + err.message, 'error');
    });
}

function refreshOnuPower(onuId, serial) {
    showOnuDetailModal(onuId, serial);
}

function doSyncRefresh() {
    var btn = $('#btnSync');
    btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i>Syncing...');

    var xhr = new XMLHttpRequest();
    xhr.open('POST', '/admin/network/olt/' + oltId + '/live-refresh', true);
    xhr.setRequestHeader('X-CSRF-TOKEN', csrfToken);
    xhr.setRequestHeader('Accept', 'application/json');
    xhr.setRequestHeader('Content-Type', 'application/json');
    xhr.timeout = 30000;

    xhr.onload = function() {
        btn.prop('disabled', false).html('<i class="fas fa-sync-alt mr-1"></i>Sync');
        if (xhr.status === 200) {
            try {
                var res = JSON.parse(xhr.responseText);
                if (res.success) {
                    location.reload();
                } else {
                    Swal.fire('Sync Failed', res.message || 'Unknown error', 'error');
                }
            } catch(e) {
                Swal.fire('Error', 'Invalid response', 'error');
            }
        } else {
            Swal.fire('Error', 'Sync request failed (HTTP ' + xhr.status + ')', 'error');
        }
    };
    xhr.onerror = function() {
        btn.prop('disabled', false).html('<i class="fas fa-sync-alt mr-1"></i>Sync');
        Swal.fire('Error', 'Network error during sync', 'error');
    };
    xhr.ontimeout = function() {
        btn.prop('disabled', false).html('<i class="fas fa-sync-alt mr-1"></i>Sync');
        Swal.fire('Timeout', 'Sync took too long. Try again.', 'warning');
    };
    xhr.send('{}');
}

function showOnuDetailModal(onuId, serial) {
    $('#onuDetailModal').modal('show');
    $('#onuDetailBody').html('<div class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x text-info"></i><p class="mt-2 text-muted">Syncing from OLT...</p></div>');
    $('#onuDetailModalTitle').text('ONU: ' + serial);
    $.ajax({
        url: '/admin/network/onu/' + onuId + '/live-info',
        type: 'GET',
        timeout: 40000,
        success: function(res) {
            if (res.success && res.data) {
                renderOnuDetailModal(res.data);
            } else {
                $('#onuDetailBody').html('<div class="alert alert-danger"><i class="fas fa-exclamation-triangle mr-2"></i>' + (res.message || 'Failed to fetch ONU info') + '</div>');
            }
        },
        error: function() {
            $('#onuDetailBody').html('<div class="alert alert-danger"><i class="fas fa-exclamation-triangle mr-2"></i>Connection error. Could not fetch ONU info.</div>');
        }
    });
}

function renderOnuDetailModal(d) {
    var rxColor = '#6c757d';
    var rxQuality = 'N/A';
    if (d.rx_power !== null && d.rx_power !== undefined) {
        rxColor = d.rx_power >= -15 ? '#28a745' : (d.rx_power >= -20 ? '#17a2b8' : (d.rx_power >= -25 ? '#ffc107' : '#dc3545'));
        rxQuality = d.rx_power >= -15 ? 'Excellent' : (d.rx_power >= -20 ? 'Good' : (d.rx_power >= -25 ? 'Fair' : 'Poor'));
    }
    var statusBadge = d.status === 'online'
        ? '<span class="badge badge-success px-3 py-1" style="font-size:14px;">ONLINE</span>'
        : '<span class="badge badge-danger px-3 py-1" style="font-size:14px;">OFFLINE</span>';
    var srcBadge = d.source === 'live'
        ? '<span class="badge badge-success ml-2"><i class="fas fa-bolt mr-1"></i>Live from OLT</span>'
        : '<span class="badge badge-secondary ml-2"><i class="fas fa-database mr-1"></i>Cached</span>';

    var html = '<div style="font-size:13px;">';

    // Header row
    html += '<div class="d-flex justify-content-between align-items-center mb-3">';
    html += '<div>' + statusBadge + srcBadge + '</div>';
    html += '<small class="text-muted">OLT: ' + (d.olt_name || '—') + '</small>';
    html += '</div>';

    // Signal quality visual
    if (d.rx_power !== null && d.rx_power !== undefined) {
        var pct = Math.min(Math.max(((d.rx_power + 30) / 20) * 100, 0), 100);
        html += '<div class="mb-3 p-2" style="background:#f8f9fa; border-radius:6px; border-left:4px solid ' + rxColor + ';">';
        html += '<div class="d-flex justify-content-between mb-1"><strong style="color:' + rxColor + ';">RX Power: ' + d.rx_power + ' dBm</strong>';
        html += '<span style="color:' + rxColor + '; font-weight:700;">' + rxQuality + '</span></div>';
        html += '<div class="progress" style="height:8px;"><div class="progress-bar" style="width:' + pct + '%; background:' + rxColor + ';"></div></div>';
        if (d.rx_power_mw) html += '<small class="text-muted">(' + d.rx_power_mw + ' mW)</small>';
        html += '</div>';
    }

    html += '<table class="table table-sm table-bordered mb-2">';
    html += '<tbody>';
    html += '<tr><td style="width:40%;font-weight:600;background:#f8f9fa;">Serial Number</td><td><code>' + (d.serial || '—') + '</code></td></tr>';
    html += '<tr><td style="font-weight:600;background:#f8f9fa;">MAC Address</td><td><code>' + (d.mac || '—') + '</code></td></tr>';
    html += '<tr><td style="font-weight:600;background:#f8f9fa;">Port / ONU#</td><td>' + (d.port || '—') + ' / ' + (d.onu_number || '—') + '</td></tr>';
    html += '<tr><td style="font-weight:600;background:#f8f9fa;">Model</td><td>' + (d.model || '—') + '</td></tr>';
    html += '<tr><td style="font-weight:600;background:#f8f9fa;">TX Power</td><td>' + (d.tx_power !== null && d.tx_power !== undefined ? d.tx_power + ' dBm' + (d.tx_power_mw ? ' (' + d.tx_power_mw + ' mW)' : '') : '—') + '</td></tr>';
    html += '<tr><td style="font-weight:600;background:#f8f9fa;">Temperature</td><td>' + (d.temperature !== null && d.temperature !== undefined ? d.temperature + ' °C' : '—') + '</td></tr>';
    html += '<tr><td style="font-weight:600;background:#f8f9fa;">Voltage</td><td>' + (d.voltage !== null && d.voltage !== undefined ? d.voltage + ' V' : '—') + '</td></tr>';
    html += '<tr><td style="font-weight:600;background:#f8f9fa;">TX Bias</td><td>' + (d.tx_bias !== null && d.tx_bias !== undefined ? d.tx_bias + ' mA' : '—') + '</td></tr>';
    html += '<tr><td style="font-weight:600;background:#f8f9fa;">Distance</td><td>' + (d.distance !== null && d.distance !== undefined ? '<strong>' + d.distance + '</strong> m' : '—') + '</td></tr>';
    if (d.client_name) {
        html += '<tr><td style="font-weight:600;background:#f8f9fa;">Client</td><td>' + d.client_name + (d.client_code ? ' <small class="text-muted">(' + d.client_code + ')</small>' : '') + '</td></tr>';
        html += '<tr><td style="font-weight:600;background:#f8f9fa;">Phone</td><td>' + (d.client_phone || '—') + '</td></tr>';
    }
    html += '</tbody></table>';
    html += '<small class="text-muted">Last synced: ' + (d.polled_at || '—') + '</small>';
    html += '</div>';

    $('#onuDetailModalTitle').text('ONU Details — ' + (d.mac || d.serial || ''));
    $('#onuDetailBody').html(html);
}

function discoverOnus() {
    var btn = $('#btnDiscover');
    btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i>Discovering...');

    $.ajax({
        url: '{{ route("admin.olt.discover-onus", $olt) }}',
        type: 'POST',
        headers: {'X-CSRF-TOKEN': csrfToken},
        success: function(res) {
            btn.prop('disabled', false).html('<i class="fas fa-search mr-1"></i>Discover ONUs');
            if (res.success && res.data.length > 0) {
                var html = '';
                res.data.forEach(function(onu) {
                    html += '<tr>';
                    html += '<td><code>' + onu.serial + '</code></td>';
                    html += '<td>' + onu.port + '</td>';
                    html += '<td><span class="badge badge-info">' + onu.vendor + '</span></td>';
                    html += '<td><button class="btn btn-success btn-sm" onclick="showProvisionModal(\'' + onu.serial + '\', \'' + onu.port + '\')"><i class="fas fa-plus mr-1"></i>Provision</button></td>';
                    html += '</tr>';
                });
                $('#discoveredOnusBody').html(html);
                $('#discoveredOnusCard').removeClass('d-none');
            } else {
                $('#discoveredOnusBody').html('<tr><td colspan="4" class="text-center py-3 text-muted">No unregistered ONUs found</td></tr>');
                $('#discoveredOnusCard').removeClass('d-none');
            }
        },
        error: function() {
            btn.prop('disabled', false).html('<i class="fas fa-search mr-1"></i>Discover ONUs');
            Swal.fire('Error', 'Failed to discover ONUs', 'error');
        }
    });
}

function showProvisionModal(serial, port) {
    $('#provSerial').val(serial);
    $('#provPort').val(port);
    $('#provSerialDisplay').val(serial);
    $('#provPortDisplay').val(port);
    $('#provisionModal').modal('show');
}

function submitProvision() {
    var btn = $('#btnProvision');
    btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i>Provisioning...');

    $.ajax({
        url: '{{ route("admin.olt.provision-onu", $olt) }}',
        type: 'POST',
        data: $('#provisionForm').serialize(),
        headers: {'X-CSRF-TOKEN': csrfToken},
        success: function(res) {
            btn.prop('disabled', false).html('<i class="fas fa-check mr-1"></i>Provision');
            if (res.success) {
                $('#provisionModal').modal('hide');
                Swal.fire('Success', 'ONU provisioned successfully!', 'success').then(() => location.reload());
            } else {
                Swal.fire('Failed', res.message || 'Provisioning failed', 'error');
            }
        },
        error: function(xhr) {
            btn.prop('disabled', false).html('<i class="fas fa-check mr-1"></i>Provision');
            var msg = 'Error provisioning ONU';
            if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
            Swal.fire('Error', msg, 'error');
        }
    });
}

function showAssignModal(onuId, serial) {
    $('#assignOnuId').val(onuId);
    $('#assignSerialDisplay').val(serial);
    $('#assignModal').modal('show');
}

function submitAssign() {
    var onuId = $('#assignOnuId').val();
    var clientId = $('#assignOnuClientSearchId').val();
    if (!clientId) { Swal.fire('Warning', 'Please select a client', 'warning'); return; }

    $.ajax({
        url: '/admin/network/onu/' + onuId + '/assign',
        type: 'POST',
        data: {client_id: clientId},
        headers: {'X-CSRF-TOKEN': csrfToken},
        success: function(res) {
            if (res.success) {
                $('#assignModal').modal('hide');
                location.reload();
            } else {
                Swal.fire('Failed', res.message || 'Assignment failed', 'error');
            }
        },
        error: function() { Swal.fire('Error', 'Error assigning ONU', 'error'); }
    });
}

function showDecommissionModal(onuId, serial) {
    $('#decommOnuId').val(onuId);
    $('#decommSerialDisplay').val(serial);
    $('#decommReason').val('');
    $('#decommissionModal').modal('show');
}

function submitDecommission() {
    var onuId = $('#decommOnuId').val();
    var reason = $('#decommReason').val();

    $.ajax({
        url: '/admin/network/onu/' + onuId + '/decommission',
        type: 'POST',
        data: {reason: reason},
        headers: {'X-CSRF-TOKEN': csrfToken},
        success: function(res) {
            if (res.success) {
                $('#decommissionModal').modal('hide');
                location.reload();
            } else {
                Swal.fire('Failed', res.message || 'Decommission failed', 'error');
            }
        },
        error: function() { Swal.fire('Error', 'Error decommissioning ONU', 'error'); }
    });
}
</script>
@endpush
