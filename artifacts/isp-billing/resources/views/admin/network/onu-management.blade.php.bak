                    @forelse($onus as $index => $onu)
                    @php
                        $ponType = strtoupper($olt->pon_type ?? 'EPON');
                        $onuIdDisplay = ($onu->pon_port ?: '0/1') . ':' . ($onu->onu_number ?? ($index + 1));
                        $isOnline = $onu->status === 'online';

                        $rxDbm = $onu->rx_power;
                        $txDbm = $onu->tx_power;
                        $rxMw = $rxDbm ? round(pow(10, $rxDbm / 10), 2) : null;
                        $txMw = $txDbm ? round(pow(10, $txDbm / 10), 2) : null;

                        $rxClass = 'power-poor';
                        if ($rxDbm !== null) {
                            if ($rxDbm >= -15) $rxClass = 'power-excellent';
                            elseif ($rxDbm >= -20) $rxClass = 'power-good';
                            elseif ($rxDbm >= -25) $rxClass = 'power-fair';
                        }

                        $txClass = 'power-good';
                        if ($txDbm !== null) {
                            if ($txDbm >= -3 && $txDbm <= 5) $txClass = 'power-excellent';
                            elseif ($txDbm < -5 || $txDbm > 7) $txClass = 'power-poor';
                        }

                        $reason = '';
                        $reasonClass = '';
                        if (!$isOnline) {
                            $dr = $onu->down_reason ?? '';
                            if (stripos($dr, 'power') !== false || stripos($dr, 'dying') !== false) {
                                $reason = 'Power Down';
                                $reasonClass = 'reason-poweroff';
                                if ($onu->last_offline) {
                                    $reason .= ' ' . \Carbon\Carbon::parse($onu->last_offline)->format('H:i:s');
                                }
                            } elseif (stripos($dr, 'word') !== false) {
                                $reason = 'Word Down';
                                $reasonClass = 'reason-wiredown';
                            } elseif (stripos($dr, 'wire') !== false || stripos($dr, 'los') !== false || stripos($dr, 'fiber') !== false || stripos($dr, 'link') !== false) {
                                $reason = 'Wire/Link Down';
                                $reasonClass = 'reason-wiredown';
                            } elseif ($dr) {
                                $reason = strtoupper(str_replace('-', ' ', $dr));
                                $reasonClass = 'reason-wiredown';
                            } else {
                                $reason = 'Offline';
                                $reasonClass = 'reason-wiredown';
                            }
                        }

                        $clientCount = 0;
                        if ($onu->client_id) $clientCount = 1;
                    @endphp
                    <tr data-onu-id="{{ $onu->id }}" data-serial="{{ $onu->serial_number }}">
                        <td class="text-center">{{ $onus->firstItem() + $index }}.</td>
                        <td>
                            <a href="{{ route('admin.olt.onu-detail', $onu->id) }}" class="onu-id-link">{{ $onuIdDisplay }}</a>
                        </td>
                        <td class="td-status">
                            @if($isOnline)
                                <span class="status-online">ONLINE</span>
                            @else
                                <span class="status-offline">OFFLINE</span>
                            @endif
                        </td>
                        <td><span class="mac-addr">{{ $onu->mac_address ?? '-' }}</span></td>
                        <td>{{ $onu->model ?? '' }}</td>
                        <td class="td-description">
                            @if($onu->description)
                                {{ \Illuminate\Support\Str::limit($onu->description, 30) }}
                            @elseif($onu->client_name)
                                <span class="text-primary">{{ $onu->client_name }}</span>
                            @else
                                <span class="text-muted">-</span>
                            @endif
                        </td>
                        <td class="td-tx">
                            @if($isOnline && $txDbm !== null)
                                <span class="{{ $txClass }}">{{ number_format($txDbm, 2) }} dBm</span>
                            @else
                                <span class="text-muted">-</span>
                            @endif
                        </td>
                        <td class="td-rx">
                            @if($isOnline && $rxDbm !== null)
                                <span class="{{ $rxClass }}">{{ number_format($rxDbm, 2) }} dBm</span>
                            @else
                                <span class="text-muted">-</span>
                            @endif
                        </td>
                        <td class="td-distance" style="font-size:12px;">
                            @if($onu->distance)
                                {{ $onu->distance }} m
                            @else
                                <span class="text-muted">-</span>
                            @endif
                        </td>
                        <td class="td-temp" style="white-space:nowrap;">
                            @if($isOnline && $onu->temperature !== null)
                                <span style="font-size:13px; font-weight:700; color:{{ $onu->temperature > 75 ? '#dc3545' : ($onu->temperature > 60 ? '#ffc107' : '#fd7e14') }};">{{ number_format($onu->temperature, 1) }} °C</span>
                            @else
                                <span class="text-muted">-</span>
                            @endif
                        </td>
                        <td class="td-volt" style="white-space:nowrap;">
                            @if($isOnline && $onu->voltage !== null)
                                <span style="font-size:13px; font-weight:700; color:{{ $onu->voltage < 3.0 || $onu->voltage > 3.6 ? '#dc3545' : '#17a2b8' }};">{{ number_format($onu->voltage, 2) }} V</span>
                            @else
                                <span class="text-muted">-</span>
                            @endif
                        </td>
        @php
                            $inBytes  = $onu->in_octets  ?? 0;
                            $outBytes = $onu->out_octets ?? 0;
                            function fmtBytes($b) {
                                if ($b >= 1073741824) return number_format($b/1073741824,2).' GB';
                                if ($b >= 1048576)    return number_format($b/1048576,2).' MB';
                                if ($b >= 1024)       return number_format($b/1024,1).' KB';
                                return $b > 0 ? $b.' B' : '-';
                            }
                        @endphp
                        <td style="text-align:center; white-space:nowrap;">
                            @if($isOnline && $inBytes > 0)
                                <span style="font-size:12px; font-weight:600; color:#28a745;">{{ fmtBytes($inBytes) }}</span>
                            @else
                                <span class="text-muted" style="font-size:11px;">-</span>
                            @endif
                        </td>
                        <td style="text-align:center; white-space:nowrap;">
                            @if($isOnline && $outBytes > 0)
                                <span style="font-size:12px; font-weight:600; color:#17a2b8;">{{ fmtBytes($outBytes) }}</span>
                            @else
                                <span class="text-muted" style="font-size:11px;">-</span>
                            @endif
                        </td>
        <td class="td-reason">
                            @if(!$isOnline)
                                <span class="reason-text {{ $reasonClass }}">{{ $reason }}</span>
                            @else
                                <span class="text-muted">-</span>
                            @endif
                        </td>
                        <td class="text-center td-found">
